#
# UNICORE execution backend configuration
#

# base location for job directories (on the target machine)
XNJS.filespace=${HPC_JOBS_DIRECTORY}

XNJS.staging.filesystemGraceTime=30
XNJS.idbfile=/local/idb.json
XNJS.numberofworkers=4

CLASSICTSI.machine=${HPC_LOGIN_NODE}
CLASSICTSI.port=${HPC_SSH_PORT}

CLASSICTSI.priveduser=${HPC_USER}
CLASSICTSI.statusupdate.interval=30
CLASSICTSI.statusupdate.grace=2

# size of the memory buffer for transferring data to the TSI
CLASSICTSI.BUFFERSIZE=1000000

PERUSERTSI.executable=python3 ${HPC_TSI_PATH}
PERUSERTSI.setupCommand=${HPC_TSI_SETUP}
PERUSERTSI.identityResolver.1.class=eu.unicore.xnjs.tsi.remote.single.FileIdentityResolver
PERUSERTSI.identityResolver.1.file=/local/identities.json
